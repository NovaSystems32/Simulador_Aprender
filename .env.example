# Copiá este archivo a .env.local y completá los valores con los de tu
# proyecto de Supabase (Project Settings > API, y Project Settings > Database).
# NUNCA subas .env.local al control de versiones ni compartas la service role key.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Project Settings > API > Project API keys > service_role (SECRETA, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Project Settings > Database > Connection string > URI (modo "Session pooler" o directo)
# Se usa solo por scripts/apply-migrations.mjs y scripts/seed.mjs, nunca por la app en runtime.
SUPABASE_DB_URL=postgresql://postgres:tu-password@db.tu-proyecto.supabase.co:5432/postgres
